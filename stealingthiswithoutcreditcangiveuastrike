#!/bin/bash

clear

COLORS=(
"\e[31m" "\e[32m" "\e[33m" "\e[34m"
"\e[35m" "\e[36m" "\e[91m" "\e[92m"
"\e[93m" "\e[94m" "\e[95m" "\e[96m"
)

echo -e "${COLORS[$RANDOM % ${#COLORS[@]}]}"

cat << "EOF"

██╗  ██╗    ██████╗  █████╗ ███╗   ██╗███████╗██╗
██║  ██║    ██╔══██╗██╔══██╗████╗  ██║██╔════╝██║
███████║    ██████╔╝███████║██╔██╗ ██║█████╗  ██║
██╔══██║    ██╔═══╝ ██╔══██║██║╚██╗██║██╔══╝  ██║
██║  ██║    ██║     ██║  ██║██║ ╚████║███████╗███████╗
╚═╝  ╚═╝    ╚═╝     ╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝╚══════╝

EOF

echo -e "\e[0m"

typing() {
    for ((i=0; i<${#1}; i++)); do
        printf "%s" "${1:$i:1}"
        sleep 0.03
    done
    echo
}

echo "------------------------------------------------"
echo "AVM Credit - AyushTheWarrior"
echo "------------------------------------------------"
echo

typing "Ayush gave 192k lines..."
sleep 1
typing "GorrilaCoderz made it 200k lines..."
sleep 1
typing "Even AI got scared counting..."
sleep 1

echo
echo "1) Install H Panel"
echo "2) Install H Panel Node"
echo

read -p "Select Option: " OPTION

REPO="https://github.com/freediamodns/ifurstealingthisshiticancopyrightyou/archive/refs/heads/main.zip"

install_common() {

    apt update -y
    apt install -y python3 python3-pip wget unzip curl

    mkdir -p /opt/hpanel
    cd /opt/hpanel || exit

    rm -rf *

    wget -O avm.zip "$REPO"

    unzip -o avm.zip

    cd ifurstealingthisshiticancopyrightyou-main || exit

    if [ ! -f "AVM.zip" ]; then
        echo "AVM.zip not found!"
        exit 1
    fi

    unzip -o AVM.zip

    if [ ! -f "requirements.txt" ]; then
        echo "requirements.txt not found!"
        echo "Check AVM.zip structure."
        exit 1
    fi

    pip3 install -r requirements.txt
}

install_panel() {

    install_common

    if [ ! -f "avm.py" ]; then
        echo "avm.py not found!"
        exit 1
    fi

    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then

cat > /etc/systemd/system/avm.service << EOF
[Unit]
Description=H Panel
After=network.target

[Service]
Type=simple
WorkingDirectory=$(pwd)
ExecStart=/usr/bin/python3 $(pwd)/avm.py
Restart=always

[Install]
WantedBy=multi-user.target
EOF

        systemctl daemon-reload
        systemctl enable avm.service
        systemctl restart avm.service
    fi

    python3 avm.py
}

install_node() {

    install_common

    if [ ! -f "node.py" ]; then
        echo "node.py not found!"
        exit 1
    fi

    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then

cat > /etc/systemd/system/avm-node.service << EOF
[Unit]
Description=H Panel Node
After=network.target

[Service]
Type=simple
WorkingDirectory=$(pwd)
ExecStart=/usr/bin/python3 $(pwd)/node.py
Restart=always

[Install]
WantedBy=multi-user.target
EOF

        systemctl daemon-reload
        systemctl enable avm-node.service
        systemctl restart avm-node.service
    fi

    python3 node.py
}

case "$OPTION" in
    1)
        install_panel
        ;;
    2)
        install_node
        ;;
    *)
        echo "Invalid option"
        ;;
esac
