#!/bin/bash

clear

COLORS=(
"\e[31m"
"\e[32m"
"\e[33m"
"\e[34m"
"\e[35m"
"\e[36m"
"\e[91m"
"\e[92m"
"\e[93m"
"\e[94m"
"\e[95m"
"\e[96m"
)

COLOR=${COLORS[$RANDOM % ${#COLORS[@]}]}

echo -e "$COLOR"

cat << "EOF"

██╗  ██╗    ██████╗  █████╗ ███╗   ██╗███████╗██╗
██║  ██║    ██╔══██╗██╔══██╗████╗  ██║██╔════╝██║
███████║    ██████╔╝███████║██╔██╗ ██║█████╗  ██║
██╔══██║    ██╔═══╝ ██╔══██║██║╚██╗██║██╔══╝  ██║
██║  ██║    ██║     ██║  ██║██║ ╚████║███████╗███████╗
╚═╝  ╚═╝    ╚═╝     ╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝╚══════╝

EOF

echo -e "\e[0m"

echo "------------------------------------------------"
echo "AVM Credit - AyushTheWarrior"
echo "------------------------------------------------"

type_text() {
    text="$1"
    for ((i=0; i<${#text}; i++)); do
        printf "%s" "${text:$i:1}"
        sleep 0.03
    done
    echo
}

echo
type_text "Ayush gave 192k lines..."
sleep 1
type_text "GorrilaCoderz made it 200k lines..."
sleep 1
type_text "Even AI gave up counting..."
sleep 1
type_text "Anyways..."
sleep 1

echo
echo "======================================"
echo "1) Install H Panel"
echo "2) Install H Panel Node"
echo "======================================"
echo

read -p "Select Option: " OPTION

REPO="https://github.com/freediamodns/ifurstealingthisshiticancopyrightyou/archive/refs/heads/main.zip"

install_panel() {

    clear
    echo "[+] Installing H Panel..."

    apt update -y
    apt install -y python3 python3-pip wget unzip curl

    mkdir -p /opt/hpanel
    cd /opt/hpanel || exit

    rm -rf *

    wget -O avm.zip "$REPO"

    unzip -o avm.zip

    DIR=$(find . -maxdepth 1 -type d | grep ifurstealing | head -n1)

    cd "$DIR" || exit

    pip3 install -r requirements.txt

    cat > /etc/systemd/system/avm.service << EOF
[Unit]
Description=H Panel
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=$(pwd)
ExecStart=/usr/bin/python3 $(pwd)/avm.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable avm.service
    systemctl restart avm.service

    echo
    echo "======================================"
    echo "H Panel Installed Successfully!"
    echo "Auto Start Enabled"
    echo "======================================"
    echo

    python3 avm.py
}

install_node() {

    clear
    echo "[+] Installing H Panel Node..."

    apt update -y
    apt install -y python3 python3-pip wget unzip curl

    mkdir -p /opt/hpanel-node
    cd /opt/hpanel-node || exit

    rm -rf *

    wget -O avm.zip "$REPO"

    unzip -o avm.zip

    DIR=$(find . -maxdepth 1 -type d | grep ifurstealing | head -n1)

    cd "$DIR" || exit

    pip3 install -r requirements.txt

    cat > /etc/systemd/system/avm-node.service << EOF
[Unit]
Description=H Panel Node
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=$(pwd)
ExecStart=/usr/bin/python3 $(pwd)/node.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable avm-node.service
    systemctl restart avm-node.service

    echo
    echo "======================================"
    echo "H Panel Node Installed Successfully!"
    echo "Auto Start Enabled"
    echo "======================================"
    echo

    python3 node.py
}

case "$OPTION" in
    1)
        install_panel
        ;;
    2)
        install_node
        ;;
    *)
        echo "Invalid Option!"
        exit 1
        ;;
esac
